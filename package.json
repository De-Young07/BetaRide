{
  "name": "betaride",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -n api,booking -c blue,green \"npm run dev -w @betaride/api\" \"npm run dev -w @betaride/booking\"",
    "build": "npm run build --workspaces --if-present",
    "build:vercel": "node scripts/build-vercel.mjs",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {"concurrently": "^9.1.2", "typescript": "^5.7.3"}
}
